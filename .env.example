# ==============================================================================
# INS Solar Business Management Software — Production Environment Template
# Copy this file to .env before starting the server. Never commit live secrets.
# ==============================================================================

# Application Environment ('development' | 'test' | 'staging' | 'production')
NODE_ENV=production

# API Server Configuration
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=https://app.inssolar.com

# Logging Configuration ('fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace')
LOG_LEVEL=info

# Reverse Proxy Configuration ('1' for single reverse proxy hop, '2' for dual-hop, or subnet CIDRs)
# NOTE: Wildcard 'true' is strictly forbidden in production to prevent client IP spoofing
TRUST_PROXY=1

# MongoDB Connection String (Required in production)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ins_solar_prod?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/ins_solar_prod

# Session Security (Must be random cryptographically secure string, min 32 characters)
SESSION_SECRET=your-production-session-secret-min-32-chars-random-hex
SESSION_MAX_AGE_MS=86400000
SESSION_IDLE_TIMEOUT_MS=7200000

# MFA Encryption Key (AES-256-GCM 32-byte / 64 hex characters)
# Generate with: openssl rand -hex 32
MFA_ENCRYPTION_KEY=your-production-mfa-hex-key-64-characters-0123456789abcdef0123456789a

# CSRF Protection Secret (Must be random cryptographically secure string, min 32 characters)
CSRF_SECRET=your-production-csrf-secret-min-32-chars-random-hex

# Cookie Security
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_ATTEMPTS=5

# Object Storage Configuration ('s3' required in production; 'simulated' forbidden in prod)
STORAGE_PROVIDER=s3
AWS_REGION=ap-south-1
AWS_S3_BUCKET=ins-solar-documents-private
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Transactional Email Gateway Configuration (SMTP / Amazon SES / SendGrid)
# Optional in dev (falls back to SIMULATED_LOG_ONLY); recommended in production
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=AKIAIOSFODNN7SMTPUSER
SMTP_PASS=BEXAMPLEPASSWORDHERE
SMTP_FROM=no-reply@inssolar.com
SMTP_SECURE=false

# Transactional SMS Gateway Configuration (India DLT Compliant Gateway)
SMS_GATEWAY_API_KEY=your-dlt-sms-api-key-here
SMS_SENDER_ID=INSSLR

# Web Frontend Configuration (Vite)
VITE_API_BASE_URL=https://api.inssolar.com/api/v1
