# ==============================================================================
# INS Solar Business Management Software — Environment Configuration Template
# Copy this file to .env in local development. Never commit real credentials.
# ==============================================================================

# Application Environment ('development' | 'test' | 'staging' | 'production')
NODE_ENV=development

# API Server Configuration
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Logging Configuration ('fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace')
LOG_LEVEL=debug

# MongoDB Atlas Connection String (Optional for local health checks/offline dev)
# Example: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/ins_solar_dev?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/ins_solar_dev

# Session Configuration (Must be at least 32 characters in production)
SESSION_SECRET=dev-session-secret-change-in-production-min-32-chars
SESSION_MAX_AGE_MS=86400000
SESSION_IDLE_TIMEOUT_MS=7200000

# MFA Encryption Key (AES-256-GCM 32-byte / 64 hex characters)
MFA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# CSRF Protection Secret (Must be at least 32 characters in production)
CSRF_SECRET=dev-csrf-secret-change-in-production-min-32-chars

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_ATTEMPTS=5

# Web Client Configuration (Vite)
VITE_API_BASE_URL=http://localhost:4000/api/v1
