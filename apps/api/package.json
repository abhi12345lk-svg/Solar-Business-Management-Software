  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.19.0",
    "@types/node": "^22.13.9",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
