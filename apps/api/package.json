{
  "name": "@ins-solar/api",
  "version": "1.0.0",
  "description": "Express 5 Backend API for INS Solar ERP",
  "main": "./src/server.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
