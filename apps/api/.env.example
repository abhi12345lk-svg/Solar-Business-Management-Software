# ==============================================================================
# INS Solar Backend API — Environment Configuration Template
# ==============================================================================

NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=https://app.inssolar.com
LOG_LEVEL=info
TRUST_PROXY=1

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ins_solar_prod

# Secrets (Minimum 32 characters in production)
SESSION_SECRET=your-production-session-secret-min-32-chars-random-hex
MFA_ENCRYPTION_KEY=your-production-mfa-hex-key-64-characters-0123456789abcdef0123456789a
CSRF_SECRET=your-production-csrf-secret-min-32-chars-random-hex

SESSION_MAX_AGE_MS=86400000
SESSION_IDLE_TIMEOUT_MS=7200000
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Storage (s3 in production)
STORAGE_PROVIDER=s3
AWS_REGION=ap-south-1
AWS_S3_BUCKET=ins-solar-documents-private
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Email
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=AKIAIOSFODNN7SMTPUSER
SMTP_PASS=BEXAMPLEPASSWORDHERE
SMTP_FROM=no-reply@inssolar.com
SMTP_SECURE=false

# SMS
SMS_GATEWAY_API_KEY=your-dlt-sms-api-key-here
SMS_SENDER_ID=INSSLR
