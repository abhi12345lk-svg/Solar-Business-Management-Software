{
  "name": "ins-solar-monorepo",
  "version": "1.0.0",
  "description": "INS Solar Business Management System — Monorepo Root",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c cyan,magenta npm:dev:api npm:dev:web",
    "dev:api": "npm run dev --workspace=@ins-solar/api",
    "dev:web": "npm run dev --workspace=@ins-solar/web",
    "build": "npm run build --workspace=@ins-solar/shared && npm run build --workspace=@ins-solar/api && npm run build --workspace=@ins-solar/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test --workspace=@ins-solar/shared && npm run test --workspace=@ins-solar/web",
    "test:api": "npm run test --workspace=@ins-solar/api",
    "lint": "eslint .",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
    "audit:security": "npm audit --omit=dev --audit-level=high",
    "bootstrap:admin": "npm run bootstrap:admin --workspace=@ins-solar/api",
    "seed:demo": "tsx apps/api/src/scripts/seed-demo.ts",
    "ci": "npm run typecheck && npm run test && npm run build"
  },
  "overrides": {
    "braces": "^3.0.3",
    "postcss-selector-parser": "^7.1.6",
    "vitest": {
      "tinypool": "2.2.0"
    }
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "concurrently": "^10.0.6",
    "eslint": "^9.21.0",
    "prettier": "^3.5.2",
    "typescript": "^5.7.3"
  }
}
